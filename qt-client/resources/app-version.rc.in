#include "resource.h"

// windres does not pull in winver.h, so the version block must be given the
// fixed resource ID 1 explicitly; otherwise Explorer finds no version info.
#ifndef VS_VERSION_INFO
#define VS_VERSION_INFO 1
#endif

// Generated by CMake from app-version.rc.in: the file version must follow
// project(... VERSION ...) so the EXE, setup.exe and the UI never disagree.
VS_VERSION_INFO VERSIONINFO
  FILEVERSION @YIUK_RC_FILEVERSION@
  PRODUCTVERSION @YIUK_RC_FILEVERSION@
  FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
  FILEFLAGS 0x1L
#else
  FILEFLAGS 0x0L
#endif
  FILEOS 0x40004L
  FILETYPE 0x1L
  FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404b0"
    BEGIN
      VALUE "CompanyName", "Yiuk"
      VALUE "FileDescription", "@YIUK_RC_DESCRIPTION@"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "@YIUK_RC_INTERNAL@"
      VALUE "LegalCopyright", "Copyright (C) Yiuk"
      VALUE "OriginalFilename", "@YIUK_RC_FILENAME@"
      VALUE "ProductName", "Yiuk Device Assist"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x804, 1200
  END
END

IDI_YIUK_APP ICON "app.ico"
IDI_YIUK_TRAY ICON "tray.ico"
