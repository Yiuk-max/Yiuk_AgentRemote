[Unit]
Description=Yiuk Platform Gateway (WSS ingress; forwards raw frames to core)
After=network.target
Wants=network.target

[Service]
Type=simple
User=yiukplatform
Group=yiukplatform
WorkingDirectory=/opt/yiuk-platform
ExecStart=/opt/yiuk-platform/yiuk-platform-gateway -config /opt/yiuk-platform/platform.yaml
Restart=always
RestartSec=3
LimitNOFILE=65535

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/yiuk-platform

[Install]
WantedBy=multi-user.target
